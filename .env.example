# Copy to .env on the server. Never commit real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=4174

# Replace these with your exact public domains.
ALLOWED_ORIGINS=https://viryaprivateschool.com,https://www.viryaprivateschool.com

# Use a long random value for staff-only API reads.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Keep admissions data outside the code directory on the server.
DATA_DIR=D:\ViryaPrivateSchool\data

MAX_BODY_BYTES=8192
MAX_STORED_APPLICATIONS=1000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Set TRUST_PROXY=true only when the API is behind a trusted reverse proxy
# that correctly sets X-Forwarded-For.
TRUST_PROXY=false